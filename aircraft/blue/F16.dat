IDENTIFY "F-16(BLUE/MULTIROLE)"
CATEGORY FIGHTER
AFTBURNR TRUE 	# HAVE AFTERBURNER?
THRAFTBN 10.8t 	# THRUST WITH AFTERBURNER
THRMILIT 8.6t 	# THRUST AT MILITARY POWER
WEIGHCLN 10.0t 	# WEIGHT CLEAN
WEIGFUEL 3.0t 	# WEIGHT OF FUEL
WEIGLOAD 6.0t 	# WEIGHT OF PAYLOAD
FUELABRN 7.5kg 	# FUEL CONSUMPTION WHEN USING AFTERBURNER
FUELMILI 0.36kg 	# FUEL CONSUMPTION AT MILITARY POWER
GUNINTVL 0.01

COCKPITP 0.0m  0.84m   3.95m	# COCKPIT POSITION
LEFTGEAR -1.35m -1.86m -0.88m	# LEFT LANDING GEAR POSITION
RIGHGEAR 1.35m -1.86m -0.88m	# RIGHT LANDING GEAR POSITION
WHELGEAR 0.0m -1.86m  3.04m	# WHEEL POSITION
ARRESTER 0.0m -1.365m -4.527m
MACHNGUN -0.775m  0.215m  3.03m	# MACHINE GUN POSITION
SMOKEGEN 0.00m -0.91m -5.615m	# SMOKE GENERATOR POSITION
VAPORPO0 4.975m  0.00m -2.865m	# VAPOR POSITION (Wings Swept Back or no-VGW)
VAPORPO1 4.975m  0.00m -2.865m	# VAPOR POSITION (Wings Spread)
HTRADIUS 8m

TRIGGER1 GUN
TRIGGER2 AAM
TRIGGER3 AGM
TRIGGER4 SMK

STRENGTH 12

CRITAOAP 25.25deg 	# CRITICAL AOA POSITIVE
CRITAOAM -15deg 	# CRITICAL AOA NEGATIVE

CRITSPED 1.0MACH 	# CRITICAL SPEED
MAXSPEED 1.3MACH 	# MAXIMUM SPEED

HASSPOIL TRUE 	# HAS SPOILER?
RETRGEAR TRUE 	# HAS RETRACTABLE LANDING GEAR?
VARGEOMW FALSE 	# HAS VARIABLE GEOMETRY WING?

CLVARGEO 0.0 	# EFFECT OF VARIABLE GEOMETRY WING FOR Cl
CDVARGEO 0.0 	# EFFECT OF VARIABLE GEOMETRY WING FOR Cd
CLBYFLAP 0.35 	# EFFECT OF FLAP FOR Cl
CDBYFLAP 0.42 	# EFFECT OF FLAP FOR Cd
CDBYGEAR 0.5 	# EFFECT OF GEAR FOR Cd
CDSPOILR 1.3 	# EFFECT OF SPOILER FOR Cd

WINGAREA 28m^2 	# WING AREA

MXIPTAOA 28.50deg 	# MAX INPUT AOA
MXIPTSSA 7.5deg 	# MAX INPUT SSA
MXIPTROL 190.0deg 	# MAX INPUT ROLL

REM CPITMANE corresponds to Spring Constant K
REM CPITSTAB corresponds to Damper Constant B
REM To be critically damped, B=2*sqrt(K)
REM 2% Settling Time=??

MANESPD1 100kt 	# MINIMUM MANEUVABLE SPEED
MANESPD2 260kt 	# FULLY MANEUVABLE SPEED
CPITMANE 8.25 	# PITCH MANEUVERBILITY CONSTANT
CPITSTAB 3.0 	# PITCH STABILITY CONSTANT
CYAWMANE 9.0 	# YAW MANEUVABILITY CONSTANT
CYAWSTAB 8.5 	# YAW STABILITY CONSTANT
CROLLMAN 4.5 	# ROLL MANEUVABILITY CONSTANT

CTLLDGEA TRUE 	# CONTROL LANDINGGEAR
CTLBRAKE FALSE 	# CONTROL BRAKE
CTLSPOIL 0.0	# CONTROL SPOILER
CTLABRNR FALSE 	# CONTROL AFTERBURNER
CTLTHROT 0.0	# CONTROL THRUST
CTLIFLAP 0.0	# CONTROL FLAP
CTLINVGW 0.0	# CONTROL VARIABLE GEOMETRY WING
CTLATVGW FALSE	# CONTROL AUTO VARIABLE GEOMETRY WING

POSITION 0m 3ft 0m	# POSITION
ATTITUDE 45deg 0deg 0deg	# ATTITUDE
INITFUEL 75%	# INITIAL FUEL
INITLOAD 0.0t	# INITIAL PAYLOAD
INITSPED 0.0MACH	# INITIAL SPEED

HRDPOINT 0.00m -1.30m 0.00m FUEL

HRDPOINT -2.00m -0.58m -0.7m AIM120 B500 AGM65
HRDPOINT 2.00m -0.58m -0.7m AIM120 B500 AGM65
HRDPOINT -3.25m -0.60m -1.35m AIM9 B500 AGM65
HRDPOINT 3.25m -0.60m -1.35m AIM9 B500 AGM65
HRDPOINT -4.05m -0.60m -1.35m AIM9
HRDPOINT 4.05m -0.60m -1.35m AIM9
HRDPOINT -4.93m 0m -1.56m RKT*9
HRDPOINT 4.93m 0m -1.56m RKT*9

LMTBYHDP TRUE 	# Limit Max Num Weapon by Hardpoint

GUNPOWER 2
INITIGUN 300 	# INITIAL GUN
LOADWEPN AIM120 4
LOADWEPN AIM9 2
LOADWEPN B500 4
INITIAGM 0 	# INITIAL AGM

MAXNMFLR 50;
LOADWEPN FLR 40
FLAREPOS 0.0m -0.80m -0.0m  0.0m -20.0m 0.0m 	# FLARE DISPENSER POSITION AND VELOCITY

REM ClZero,CdZero is fixed by Cruising condition
REFVCRUS 1.0MACH 	# CRUISING SPEED
REFACRUS 7000ft 	# CRUISING ALTITUDE
REFTCRUS 1.3 	# CRUISING THROTTLE SETTING

REM ClSlope,CdConst is fixed by Landing condition
REFVLAND 130kt 	# LANDING SPEED
REFAOALD 14deg 	# LANDING AOA
REFLNRWY 800m 	# RUNWAY REQUIRED TO STOP
REFTHRLD 0.45 	# LANDING THROTTLE SETTING

NMTURRET 1
TURRETPO 0 0.0m 0.0m 0.0m 0deg 0deg 0deg 	# Number x y z h p b
TURRETPT 0 -30deg 30deg 0deg	# Number MinPitch MaxPitch NeutralPitch
TURRETHD 0 -30deg 30deg 0deg	# Number MinHdg MaxHdg NeutralHdg
TURRETAM 0 0	# Ammo
TURRETIV 0 1sec	# Number ShootingInterval
TURRETNM 0 irstpipper	# DNM Node Name
TURRETAR 0	# Anti Air Capable
TURRETCT 0 GUNNER	# Controlled by the pilot
TURRETRG 0 8000m

WPNSHAPE FUEL STATIC user/RvB/weapon/AmericanFuelTank.srf
WPNSHAPE FUEL FLYING user/RvB/weapon/AmericanFuelTank.srf
WPNSHAPE B500 STATIC user/RvB/weapon/BLU-107.srf
WPNSHAPE B500 FLYING user/RvB/weapon/BLU-107.srf
WPNSHAPE B250 STATIC user/RvB/weapon/Mk81.srf
WPNSHAPE B250 FLYING user/RvB/weapon/Mk81.srf
WPNSHAPE AIM120 STATIC user/RvB/weapon/AIM-120Bs.srf
WPNSHAPE AIM120 FLYING user/RvB/weapon/AIM-120B.srf
WPNSHAPE RKT STATIC user/RvB/weapon/M261s.srf
WPNSHAPE RKT FLYING user/RvB/weapon/M261.srf
WPNSHAPE AGM65 STATIC user/RvB/weapon/AM-39s.srf
WPNSHAPE AGM65 FLYING user/RvB/weapon/AM-39.srf
WPNSHAPE AIM9 STATIC user/RvB/weapon/R-550s.srf
WPNSHAPE AIM9 FLYING user/RvB/weapon/R-550.srf
WPNSHAPE FLR FLYING user/RvB/weapon/flr.srf
AUTOCALC 
MAXNMAAM 999
MAXNMAGM 999
MAXNBOMB 999
MAXNMRKT 38
