IDENTIFY "SU-22(RED/ATTACKER)"
CATEGORY ATTACKER
AFTBURNR TRUE 	# HAVE AFTERBURNER?
THRAFTBN 12.1t 	# THRUST WITH AFTERBURNER
THRMILIT 11.6t 	# THRUST AT MILITARY POWER
WEIGHCLN 14.8t 	# WEIGHT CLEAN
WEIGFUEL 3.0t 	# WEIGHT OF FUEL
WEIGLOAD 6.0t 	# WEIGHT OF PAYLOAD
FUELABRN 5.9kg 	# FUEL CONSUMPTION WHEN USING AFTERBURNER
FUELMILI 0.26kg 	# FUEL CONSUMPTION AT MILITARY POWER
GUNINTVL 0.01

VGWSPED1 500kt
VGWSPED2 501kt

COCKPITP  0.0m  0.99m  4.75m  #COCKPIT POSITION
LEFTGEAR -1.70m -1.75m -0.80m  #LEFT LANDING GEAR POSITION
RIGHGEAR  1.70m -1.75m -0.80m  #RIGHT LANDING GEAR POSITION
WHELGEAR  0.0m -1.97m  4.40m  #WHEEL POSITION
ARRESTER  0.0m -1.35m -5.2m
MACHNGUN -1.30m 0.00m  2.50m  #MACHINE GUN POSITION
MACHNGN2 1.30m 0.00m  2.50m  #MACHINE GUN POSITION
SMOKEGEN  0.00m 0.87m -8.00m  #SMOKE GENERATOR POSITION
VAPORPO0  4.96m  -0.17m -5.30m  #VAPOR POSITION (Wings Swept back)
VAPORPO1  6.82m  0.23m -3.35m  #VAPOR POSITION (Wings Spread)
HTRADIUS 9.6m

TRIGGER1 GUN
TRIGGER2 AAM
TRIGGER3 AGM
TRIGGER4 SMK

GEARHORN FALSE
STRENGTH 18

CRITAOAP 23.75deg 	# CRITICAL AOA POSITIVE
CRITAOAM -15deg 	# CRITICAL AOA NEGATIVE

CRITSPED 0.9MACH 	# CRITICAL SPEED
MAXSPEED 1.1MACH 	# MAXIMUM SPEED

HASSPOIL TRUE 	# HAS SPOILER?
RETRGEAR TRUE 	# HAS RETRACTABLE LANDING GEAR?
VARGEOMW FALSE 	# HAS VARIABLE GEOMETRY WING?

CLVARGEO 0.0 	# EFFECT OF VARIABLE GEOMETRY WING FOR Cl
CDVARGEO 0.0 	# EFFECT OF VARIABLE GEOMETRY WING FOR Cd
CLBYFLAP 0.35 	# EFFECT OF FLAP FOR Cl
CDBYFLAP 0.42 	# EFFECT OF FLAP FOR Cd
CDBYGEAR 0.5 	# EFFECT OF GEAR FOR Cd
CDSPOILR 1.3 	# EFFECT OF SPOILER FOR Cd

WINGAREA 28m^2 	# WING AREA

MXIPTAOA 26.00deg 	# MAX INPUT AOA
MXIPTSSA 8.0deg 	# MAX INPUT SSA
MXIPTROL 160.0deg 	# MAX INPUT ROLL

REM CPITMANE corresponds to Spring Constant K
REM CPITSTAB corresponds to Damper Constant B
REM To be critically damped, B=2*sqrt(K)
REM 2% Settling Time=??

MANESPD1 100kt 	# MINIMUM MANEUVABLE SPEED
MANESPD2 200kt 	# FULLY MANEUVABLE SPEED
CPITMANE 7.25 	# PITCH MANEUVERBILITY CONSTANT
CPITSTAB 2.7 	# PITCH STABILITY CONSTANT
CYAWMANE 7.0 	# YAW MANEUVABILITY CONSTANT
CYAWSTAB 6.5 	# YAW STABILITY CONSTANT
CROLLMAN 3.6 	# ROLL MANEUVABILITY CONSTANT

CTLLDGEA TRUE 	# CONTROL LANDINGGEAR
CTLBRAKE FALSE 	# CONTROL BRAKE
CTLSPOIL 0.0                  #CONTROL SPOILER
CTLABRNR FALSE 	# CONTROL AFTERBURNER
CTLTHROT 0.0                  #CONTROL THRUST
CTLIFLAP 0.0                  #CONTROL FLAP
CTLINVGW 0.0                  #CONTROL VARIABLE GEOMETRY WING
CTLATVGW FALSE                #CONTROL AUTO VARIABLE GEOMETRY WING

POSITION 0m 3ft 0m           #POSITION
ATTITUDE 45deg 0deg 0deg      #ATTITUDE
INITFUEL 75%                  #INITIAL FUEL
INITLOAD 0.0t                 #INITIAL PAYLOAD
INITSPED 0.0MACH              #INITIAL SPEED


MAXNMAAM 999
MAXNMAGM 999
MAXNBOMB 999
MAXNMRKT 64

HRDPOINT -0.55m -0.95m 1.65m AIM9
HRDPOINT 0.55m -0.95m 1.65m AIM9
HRDPOINT -1.25m -0.45m 2.70m B500 RKT B250*2 B500HD
HRDPOINT 1.25m -0.45m 2.70m B500 RKT B250*2 B500HD
HRDPOINT -1.74m -0.60m 1.00m  B500*2 AGM65*2 B250*4 B500HD*2
HRDPOINT 1.74m -0.60m 1.00m  B500*2 AGM65*2  B250*4 B500HD*2
HRDPOINT -2.55m -0.70m -1.50m AGM65 B500*2 FUEL B250*4 B500HD*2
HRDPOINT 2.55m -0.70m -1.50m AGM65 B500*2 FUEL B250*4 B500HD*2

LMTBYHDP TRUE 	# Limit Max Num Weapon by Hardpoint

GUNPOWER 2
LMTBYHDP TRUE 	# Limit Max Num Weapon by Hardpoint
INITIGUN 1100 	# INITIAL GUN
INITIAAM 4 	# INITIAL AAM
INITIAGM 0 	# INITIAL AGM
INITBOMB 4

MAXNMFLR 55

FLAREPOS 0.0m -0.80m -0.0m  0.0m -20.0m 0.0m 	# FLARE DISPENSER POSITION AND VELOCITY



REM ClZero,CdZero is fixed by Cruising condition
REFVCRUS 0.9MACH 	# CRUISING SPEED
REFACRUS 7000ft 	# CRUISING ALTITUDE
REFTCRUS 1.1 	# CRUISING THROTTLE SETTING

REM ClSlope,CdConst is fixed by Landing condition
REFVLAND 130kt 	# LANDING SPEED
REFAOALD 14deg 	# LANDING AOA
REFLNRWY 800m 	# RUNWAY REQUIRED TO STOP
REFTHRLD 0.45 	# LANDING THROTTLE SETTING


NMTURRET 1
TURRETPO 0 0.0m 0.0m 0.0m 0deg 0deg 0deg 	# Number x y z h p b
TURRETPT 0 -30deg 30deg 0deg                  # Number MinPitch MaxPitch NeutralPitch
TURRETHD 0 -30deg 30deg 0deg               # Number MinHdg MaxHdg NeutralHdg
TURRETAM 0 0                              # Ammo
TURRETIV 0 1sec                           # Number ShootingInterval
TURRETNM 0 irstpipper                              # DNM Node Name
TURRETAR 0                                   # Anti Air Capable
TURRETCT 0 GUNNER                             # Controlled by the pilot
TURRETRG 0 8000m

WPNSHAPE FUEL STATIC user/RvB/weapon/RussianFuelTank.srf
WPNSHAPE FUEL FLYING user/RvB/weapon/RussianFuelTank.srf
WPNSHAPE B500 STATIC user/RvB/weapon/FAB-250.srf
WPNSHAPE B500 FLYING user/RvB/weapon/FAB-250.srf
WPNSHAPE B250 STATIC user/RvB/weapon/FAB-100.srf
WPNSHAPE B250 FLYING user/RvB/weapon/FAB-100.srf
WPNSHAPE AIM120 STATIC user/RvB/weapon/R-27Rs.srf
WPNSHAPE AIM120 FLYING user/RvB/weapon/R-27R.srf
WPNSHAPE RKT STATIC user/RvB/weapon/UB-32-57s.srf
WPNSHAPE RKT FLYING user/RvB/weapon/UB-32-57.srf
WPNSHAPE AGM65 STATIC user/RvB/weapon/Kh-25MLs.srf
WPNSHAPE AGM65 FLYING user/RvB/weapon/Kh-25ML.srf
WPNSHAPE AIM9 STATIC user/RvB/weapon/R-60s.srf
WPNSHAPE AIM9 FLYING user/RvB/weapon/R-60.srf
WPNSHAPE FLR FLYING user/RvB/weapon/flr.srf
AUTOCALC
RADARCRS 0.90
