IDENTIFY "[RED]UCAV"
CATEGORY ATTACKER
AFTBURNR FALSE               #HAVE AFTERBURNER?
THRAFTBN 0.0t                #THRUST WITH AFTERBURNER
THRMILIT 5.7t               #THRUST AT MILITARY POWER
WEIGHCLN 6.35t                 #WEIGHT CLEAN
WEIGFUEL 15t                #WEIGHT OF FUEL
WEIGLOAD 18t                 #WEIGHT OF PAYLOAD
FUELABRN 0.0kg               #FUEL CONSUMPTION WHEN USING AFTERBURNER
FUELMILI 1.25kg               #FUEL CONSUMPTION AT MILITARY POWER

COCKPITP 0m 0.199m 6.457m  #COCKPIT POSITION
EXCAMERA "FRONT" 0m 1.309m 4.498m 0deg 0deg 0deg INSIDE
EXCAMERA "GROUND" 0.00m -0.733m 4.376m 0deg -90deg 0deg INSIDE
EXCAMERA "MAP" 0.0m 3.726m 6.421m 0deg 90deg 0deg INSIDE

LEFTGEAR -1.584m -0.847m -0.891m  #LEFT LANDING GEAR POSITION
RIGHGEAR  1.584m -0.847m -0.891m  #RIGHT LANDING GEAR POSITION
WHELGEAR  0.0m -0.872m  2.853m  #WHEEL POSITION
ARRESTER  0.0m -1.7m -7.30m
MACHNGUN -2.001m 0.667m  4.997m  #MACHINE GUN POSITION
MACHNGN2 -1.933m 0.701m  4.997m  #MACHINE GUN POSITION
SMOKEGEN  0.0m  0.00m -10.3m  #SMOKE GENERATOR POSITION
VAPORPO0 5.185m  -0.012m  -4.535m  #VAPOR POSITION (Wings Swept back)
VAPORPO1 5.185m  -0.012m  -4.535m  #VAPOR POSITION (Wings Spread)
HTRADIUS 10.7m



TRIGGER1 NON
TRIGGER2 NON
TRIGGER3 AGM
TRIGGER4 NON

STRENGTH 3

CRITAOAP  20deg               #CRITICAL AOA POSITIVE
CRITAOAM -15deg               #CRITICAL AOA NEGATIVE

CRITSPED 1.0MACH              #CRITICAL SPEED
MAXSPEED 1.15MACH              #MAXIMUM SPEED

HASSPOIL TRUE                 #HAS SPOILER?
RETRGEAR TRUE                 #HAS RETRACTABLE LANDING GEAR?
VARGEOMW FALSE                #HAS VARIABLE GEOMETRY WING?

CLVARGEO 0.0                  #EFFECT OF VARIABLE GEOMETRY WING FOR Cl
CDVARGEO 0.0                  #EFFECT OF VARIABLE GEOMETRY WING FOR Cd
CLBYFLAP 0.6                  #EFFECT OF FLAP FOR Cl
CDBYFLAP 0.75                  #EFFECT OF FLAP FOR Cd
CDBYGEAR 0.5                  #EFFECT OF GEAR FOR Cd
CDSPOILR 1.5                  #EFFECT OF SPOILER FOR Cd

WINGAREA 464m^2              #WING AREA

MXIPTAOA 15.0deg              #MAX INPUT AOA
MXIPTSSA 5.0deg               #MAX INPUT SSA
MXIPTROL 38deg             #MAX INPUT ROLL

REM CPITMANE corresponds to Spring Constant K
REM CPITSTAB corresponds to Damper Constant B
REM To be critically damped, B=2*sqrt(K)
REM 2% Settling Time=??

MANESPD1 100kt                 #MINIMUM MANEUVABLE SPEED
MANESPD2 220kt                #FULLY MANEUVABLE SPEED
CPITMANE 5.9                  #PITCH MANEUVERBILITY CONSTANT
CPITSTAB 5.2                  #PITCH STABILITY CONSTANT
CYAWMANE 3.0                  #YAW MANEUVABILITY CONSTANT
CYAWSTAB 2.0                  #YAW STABILITY CONSTANT
CROLLMAN 0.9                  #ROLL MANEUVABILITY CONSTANT

CTLLDGEA TRUE                 #CONTROL LANDINGGEAR
CTLBRAKE FALSE                #CONTROL BRAKE
CTLSPOIL 0.0                  #CONTROL SPOILER
CTLABRNR FALSE                #CONTROL AFTERBURNER
CTLTHROT 0.0                  #CONTROL THRUST
CTLIFLAP 0.0                  #CONTROL FLAP
CTLINVGW 1.0                  #CONTROL VARIABLE GEOMETRY WING
CTLATVGW TRUE                 #CONTROL AUTO VARIABLE GEOMETRY WING

POSITION 0m 3ft 0m            #POSITION
ATTITUDE 45deg 0deg 0deg      #ATTITUDE
INITFUEL 75%                   #INITIAL FUEL
INITLOAD 0.0t                 #INITIAL PAYLOAD
INITSPED 0.0MACH              #INITIAL SPEED

INITIGUN 0                    #INITIAL GUN
INITIAAM 0                    #INITIAL AAM
INITIAGM 4                   #INITIAL AGM
INITBOMB 0
WEAPONCH AGM



AGMVISIB FALSE

HRDPOINT -0.875m -0.671m 0.204m AGM65*2 B250*2 $INTERNAL
HRDPOINT 0.875m -0.671m 0.204m AGM65*2 B250*2 $INTERNAL


GUNPOWER 1
GUNINTVL 0.19
INITIGUN 0                 #INITIAL GUN
BOMVISIB FALSE

RADARCRS 0.01                  #RADAR CROSS SECTION
BOMINBAY TRUE

REM ClZero,CdZero is fixed by Cruising condition
REFVCRUS 1.1MACH              #CRUISING SPEED
REFACRUS 25000ft              #CRUISING ALTITUDE
REFTCRUS 1.2                  #CRUISING THROTTLE SETTING

REM ClSlope,CdConst is fixed by Landing condition
REFVLAND 140kt                 #LANDING SPEED
REFAOALD 12deg                 #LANDING AOA
REFLNRWY 1500m                #RUNWAY REQUIRED TO STOP
REFTHRLD 0.4                  #LANDING THROTTLE SETTING
THRSTREV 0.15 #REVERS THRUST POWER


WPNSHAPE AIM120 STATIC user/matrix_v2/weapon/astra.srf
WPNSHAPE AIM120 FLYING user/matrix_v2/weapon/astraF.srf
WPNSHAPE AIM9X STATIC user/matrix_v2/weapon/piranha.srf
WPNSHAPE AIM9X FLYING user/matrix_v2/weapon/piranhaF.srf
WPNSHAPE AGM65 STATIC user/matrix_v2/weapon/hellfire.srf
WPNSHAPE AGM65 FLYING user/matrix_v2/weapon/hellfireF.srf
WPNSHAPE AIM9 STATIC user/matrix_v2/weapon/mica2.srf
WPNSHAPE AIM9 FLYING user/matrix_v2/weapon/mica2F.srf
WPNSHAPE B250 STATIC user/matrix_v2/weapon/250lb.srf
WPNSHAPE B250 FLYING user/matrix_v2/weapon/250lb.srf
WPNSHAPE B500 STATIC user/matrix_v2/weapon/gbu12.srf
WPNSHAPE B500 FLYING user/matrix_v2/weapon/gbu12F.srf
WPNSHAPE RKT STATIC user/matrix_v2/weapon/ub32.srf
WPNSHAPE FLR FLYING user/matrix_v2/weapon/flare.srf
WPNSHAPE FLR FLYING user/RvB/weapon/flr.srf
AUTOCALC
