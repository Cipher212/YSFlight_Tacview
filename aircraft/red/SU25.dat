IDENTIFY "SU-25(RED/CAS)"
CATEGORY ATTACKER
AFTBURNR FALSE 	# HAVE AFTERBURNER?
THRAFTBN 0.0t 	# THRUST WITH AFTERBURNER
THRMILIT 9.9t 	# THRUST AT MILITARY POWER
WEIGHCLN 10t 	# WEIGHT CLEAN
WEIGFUEL 5.0t 	# WEIGHT OF FUEL
WEIGLOAD 7.2t 	# WEIGHT OF PAYLOAD
FUELABRN 0.0kg 	# FUEL CONSUMPTION WHEN USING AFTERBURNER
FUELMILI 0.325kg 	# FUEL CONSUMPTION AT MILITARY POWER

COCKPITP  0.0m  0.552m  3.70m  #COCKPIT POSITION
LEFTGEAR -1.435m -1.99m -0.15m  #LEFT LANDING GEAR POSITION
RIGHGEAR  1.435m -1.99m -0.15m  #RIGHT LANDING GEAR POSITION
WHELGEAR  -0.22m -2.01m  3.34m  #WHEEL POSITION
ARRESTER  0.0m -1.00m -4.00m
MACHNGUN  -0.36m -0.845m  4.935m  #MACHINE GUN POSITION
SMOKEGEN  0.0m  1.10m -6.00m  #SMOKE GENERATOR POSITION
VAPORPO0 -7.33m  0.08m -2.27m  #VAPOR POSITION (Wings Swept Back or no-VGW)
VAPORPO1 -7.33m  0.08m -2.27m  #VAPOR POSITION (Wings Spread)
HTRADIUS 7.7m

EXCAMERA "CO-PILOT" 0.0m 0.90m 2.20m 0deg 0deg 0deg INSIDE

GEARHORN FALSE
STRENGTH 22

CRITAOAP 23.50deg 	# CRITICAL AOA POSITIVE
CRITAOAM -12deg 	# CRITICAL AOA NEGATIVE

CRITSPED 500km/h 	# CRITICAL SPEED
MAXSPEED 982km/h 	# MAXIMUM SPEED

HASSPOIL TRUE 	# HAS SPOILER?
RETRGEAR TRUE 	# HAS RETRACTABLE LANDING GEAR?
VARGEOMW FALSE 	# HAS VARIABLE GEOMETRY WING?

CLVARGEO 0.0 	# EFFECT OF VARIABLE GEOMETRY WING FOR Cl
CDVARGEO 0.0 	# EFFECT OF VARIABLE GEOMETRY WING FOR Cd
CLBYFLAP 0.35 	# EFFECT OF FLAP FOR Cl
CDBYFLAP 0.38 	# EFFECT OF FLAP FOR Cd
CDBYGEAR 0.5 	# EFFECT OF GEAR FOR Cd
CDSPOILR 0.8 	# EFFECT OF SPOILER FOR Cd

WINGAREA 47m^2 	# WING AREA

MXIPTAOA 26.0deg 	# MAX INPUT AOA
MXIPTSSA 7.5deg 	# MAX INPUT SSA
MXIPTROL 180.0deg 	# MAX INPUT ROLL

REM CPITMANE corresponds to Spring Constant K
REM CPITSTAB corresponds to Damper Constant B
REM To be critically damped, B=2*sqrt(K)
REM 2% Settling Time=??

MANESPD1 60kt 	# MINIMUM MANEUVABLE SPEED
MANESPD2 100kt 	# FULLY MANEUVABLE SPEED
CPITMANE 5.39 	# PITCH MANEUVERBILITY CONSTANT
CPITSTAB 1.8 	# PITCH STABILITY CONSTANT
CYAWMANE 5.0 	# YAW MANEUVABILITY CONSTANT
CYAWSTAB 3.0 	# YAW STABILITY CONSTANT
CROLLMAN 2.0 	# ROLL MANEUVABILITY CONSTANT

CTLLDGEA TRUE 	# CONTROL LANDINGGEAR
CTLBRAKE FALSE 	# CONTROL BRAKE
CTLSPOIL 0.0                  #CONTROL SPOILER
CTLABRNR FALSE 	# CONTROL AFTERBURNER
CTLTHROT 0.0                  #CONTROL THRUST
CTLIFLAP 0.0                  #CONTROL FLAP
CTLINVGW 0.0                  #CONTROL VARIABLE GEOMETRY WING
CTLATVGW FALSE                #CONTROL AUTO VARIABLE GEOMETRY WING

POSITION 0m 3ft 0m           #POSITION
ATTITUDE 45deg 0deg 0deg      #ATTITUDE
INITFUEL 75%                  #INITIAL FUEL
INITLOAD 0.0t                 #INITIAL PAYLOAD
INITSPED 0.0MACH              #INITIAL SPEED




HRDPOINT 5.2m -0.30m -0.25m AGM65 B500 B500HD B250*2
HRDPOINT -5.2m -0.30m -0.25m AGM65 B500 B500HD B250*2
HRDPOINT 4.50m -0.50m -0.50m B500 B500HD B250*2
HRDPOINT -4.50m -0.50m -0.50m B500 B500HD B250*2
HRDPOINT 3.70m -0.45m -0.25m AGM65 B500 B500HD B250*2 AIM9X
HRDPOINT -3.70m -0.45m -0.25m AGM65 B500 B500HD B250*2 AIM9X
HRDPOINT 2.90m -0.40m 0.00m AGM65 B500 B500HD B250*2
HRDPOINT -2.90m -0.40m 0.00m AGM65 B500 B500HD B250*2
HRDPOINT 2.10m -0.35m 0.25m AGM65 B500 B500HD B250*2
HRDPOINT -2.10m -0.35m 0.25m AGM65 B500 B500HD B250*2
HRDPOINT 2.10m -0.35m 0.25m B500 B500HD B250*2
HRDPOINT -2.10m -0.35m 0.25m AGM65*2 B500*2 RKT*38 B500HD*2 B250*4

LMTBYHDP TRUE 	# Limit Max Num Weapon by Hardpoint

MAXNMAAM 999
MAXNMAGM 999
MAXNBOMB 999
MAXNMRKT 64

GUNPOWER 3
INITIGUN 1575 	# INITIAL GUN
INITIAAM 2 	# INITIAL AAM
INITIAGM 6 	# INITIAL AGM
INITBOMB 5 	# INITIAL BOMB
INITRCKT 38                   #INITIAL ROCKET (10kg/each)

MAXNMFLR 120;
LOADWEPN FLR 120
FLAREPOS 0.0m -0.80m -0.0m  0.0m -20.0m 0.0m 	# FLARE DISPENSER POSITION AND VELOCITY

RADARCRS 0.9

NMTURRET 1
TURRETPO 0 0.0m 0.0m 0.0m 0deg 0deg 0deg 	# Number x y z h p b
TURRETPT 0 -30deg 30deg 0deg                  # Number MinPitch MaxPitch NeutralPitch
TURRETHD 0 -30deg 30deg 0deg               # Number MinHdg MaxHdg NeutralHdg
TURRETAM 0 0                              # Ammo
TURRETIV 0 1sec                           # Number ShootingInterval
TURRETNM 0 irstpipper                              # DNM Node Name
TURRETAR 0                                   # Anti Air Capable
TURRETCT 0 GUNNER                             # Controlled by the pilot
TURRETRG 0 8000m

REM ClZero,CdZero is fixed by Cruising condition
REFVCRUS 880km/h 	# CRUISING SPEED
REFACRUS 3000ft 	# CRUISING ALTITUDE
REFTCRUS 0.8 	# CRUISING THROTTLE SETTING

REM ClSlope,CdConst is fixed by Landing condition
REFVLAND 130kt 	# LANDING SPEED
REFAOALD 14deg 	# LANDING AOA
REFLNRWY 1000m 	# RUNWAY REQUIRED TO STOP
REFTHRLD 0.65 	# LANDING THROTTLE SETTING

WPNSHAPE FUEL STATIC user/RvB/weapon/RussianFuelTank.srf
WPNSHAPE FUEL FLYING user/RvB/weapon/RussianFuelTank.srf
WPNSHAPE B500 STATIC user/RvB/weapon/FAB-250.srf
WPNSHAPE B500 FLYING user/RvB/weapon/FAB-250.srf
WPNSHAPE B250 STATIC user/RvB/weapon/FAB-100.srf
WPNSHAPE B250 FLYING user/RvB/weapon/FAB-100.srf
WPNSHAPE AIM120 STATIC user/RvB/weapon/R-27Rs.srf
WPNSHAPE AIM120 FLYING user/RvB/weapon/R-27R.srf
WPNSHAPE RKT STATIC user/RvB/weapon/UB-32-57s.srf
WPNSHAPE RKT FLYING user/RvB/weapon/UB-32-57.srf
WPNSHAPE AGM65 STATIC user/RvB/weapon/Kh-25MLs.srf
WPNSHAPE AGM65 FLYING user/RvB/weapon/Kh-25ML.srf
WPNSHAPE AIM9 STATIC user/RvB/weapon/R-60s.srf
WPNSHAPE AIM9 FLYING user/RvB/weapon/R-60.srf
WPNSHAPE FLR FLYING user/RvB/weapon/flr.srf
AUTOCALC
